# Copia este archivo como .env y completa únicamente lo que necesites.
# Usa UTF-8 sin BOM. Nunca confirmes el archivo .env en Git.

# Núcleo
# Genera una clave propia:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=reemplaza-por-una-clave-unica-generada-localmente
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Base de datos: sqlite para desarrollo o mysql para producción.
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306

# CORS. En DEBUG, si la lista está vacía, se permiten todos los orígenes.
CORS_ALLOWED_ORIGINS=

# Geocodificación inversa con Nominatim.
GEOCODING_ENABLED=True

# Notificaciones por correo. Desactivadas hasta configurar un proveedor SMTP.
NOTIFICACIONES_EMAIL_ENABLED=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Microbasurales <no-reply@example.com>

# Seguridad de producción
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Integraciones y observabilidad
POWERBI_DASHBOARD_EMBED_URL=
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
